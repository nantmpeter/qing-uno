---
// TL;DR — auto-generated summary displayed at the top of blog posts
interface Props {
  summary: string;
}

const { summary } = Astro.props;
---

{summary && (
  <div class="tldr">
    <span class="tldr-label">TL;DR</span>
    <p>{summary}</p>
  </div>
)}

<style>
  .tldr {
    display: flex;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: var(--color-bg-secondary);
    border-radius: var(--border-radius-lg, 12px);
    margin-bottom: 2rem;
    border-left: 3px solid var(--color-accent);
  }

  .tldr-label {
    flex-shrink: 0;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    padding-top: 0.15rem;
  }

  .tldr p {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }
</style>
