---
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  slug: string;
  heroImage?: string;
}

const { title, description, pubDate, tags = [], slug, heroImage } = Astro.props;
---

<article class="post-card">
  <a href={`/blog/${slug}`} class="post-card-link">
    <div class="post-content">
      <div class="post-meta">
        <FormattedDate date={pubDate} />
      </div>
      <h3 class="post-title">{title}</h3>
      <p class="post-desc">{description}</p>
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.slice(0, 3).map(tag => (
            <span class="post-tag">{tag}</span>
          ))}
        </div>
      )}
    </div>
    {heroImage && (
      <div class="post-image-wrapper">
        <img src={heroImage} alt={title} class="post-image" loading="lazy" />
      </div>
    )}
  </a>
</article>

<style>
  .post-card {
    border-radius: var(--radius-lg);
    transition: all var(--duration-normal) var(--ease-out);
  }

  .post-card-link {
    display: flex;
    gap: 1.25rem;
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    border: 1px solid transparent;
    transition: all var(--duration-normal) var(--ease-out);
    text-decoration: none;
  }

  .post-card-link:hover {
    background: var(--color-bg-card);
    border-color: var(--color-border);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .post-content {
    flex: 1;
    min-width: 0;
  }

  .post-meta {
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
    margin-bottom: 0.4rem;
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
  }

  .post-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.35;
    margin-bottom: 0.4rem;
    letter-spacing: -0.02em;
  }

  .post-card-link:hover .post-title {
    color: var(--color-text);
  }

  .post-desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 0.6rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .post-tag {
    font-size: 0.7rem;
    color: var(--color-text-tertiary);
    background: var(--color-bg-secondary);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
  }

  .post-image-wrapper {
    flex-shrink: 0;
    width: 100px;
    height: 80px;
    border-radius: var(--radius-md);
    overflow: hidden;
    align-self: center;
  }

  .post-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .post-card-link:hover .post-image {
    transform: scale(1.05);
  }

  @media (max-width: 640px) {
    .post-image-wrapper {
      width: 72px;
      height: 56px;
    }
    .post-card-link {
      padding: 0.75rem;
    }
  }
</style>
