---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/archive', label: 'Archive' },
  { href: '/search', label: 'Search' },
  { href: '/about', label: 'About' },
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class="site-header">
  <nav class="wide-container nav-inner">
    <a href="/" class="site-logo">qing<span class="logo-dot">.</span>uno</a>
    <div class="nav-links">
      {navItems.map(item => (
        <a
          href={item.href}
          class:list={['nav-link', { active: isActive(item.href) }]}
        >
          {item.label}
        </a>
      ))}
    </div>
    <button class="mobile-toggle" aria-label="Toggle menu" id="mobile-toggle">
      <span></span><span></span><span></span>
    </button>
  </nav>
  <div class="mobile-menu" id="mobile-menu">
    {navItems.map(item => (
      <a
        href={item.href}
        class:list={['mobile-link', { active: isActive(item.href) }]}
      >
        {item.label}
      </a>
    ))}
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    z-index: 100;
    padding: 1.25rem 0;
    background: color-mix(in srgb, var(--color-bg) 80%, transparent);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-normal) ease;
  }

  .site-header:hover {
    border-bottom-color: var(--color-border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
    margin-top: -1.25rem;
  }

  .site-logo {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.04em;
    font-family: var(--font-mono);
    transition: opacity var(--duration-fast) ease;
  }

  .site-logo:hover {
    opacity: 0.7;
    color: var(--color-text);
  }

  .logo-dot {
    color: var(--color-text-tertiary);
  }

  .nav-links {
    display: flex;
    gap: 0.25rem;
  }

  .nav-link {
    color: var(--color-text-secondary);
    font-size: 0.825rem;
    font-weight: 500;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
    transition: all var(--duration-fast) ease;
  }

  .nav-link:hover {
    color: var(--color-text);
    background: var(--color-bg-secondary);
  }

  .nav-link.active {
    color: var(--color-text);
    background: var(--color-bg-secondary);
    font-weight: 600;
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .mobile-toggle span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--color-text);
    border-radius: 1px;
    transition: all var(--duration-fast) ease;
  }

  .mobile-menu {
    display: none;
    padding: 0.5rem 1.5rem 1rem;
    background: color-mix(in srgb, var(--color-bg) 95%, transparent);
    backdrop-filter: blur(16px);
  }

  .mobile-menu.open { display: block; }

  .mobile-link {
    display: block;
    padding: 0.65rem 0.75rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    border-radius: var(--radius-sm);
    transition: all var(--duration-fast) ease;
  }

  .mobile-link:hover,
  .mobile-link.active {
    color: var(--color-text);
    background: var(--color-bg-secondary);
  }

  @media (max-width: 640px) {
    .nav-links { display: none; }
    .mobile-toggle { display: flex; }
    .site-header { padding: 0.75rem 0; }
    .nav-inner { margin-top: -0.75rem; }
  }
</style>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('open');
  });
</script>
