---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/archive', label: 'Archive' },
  { href: '/search', label: 'Search' },
  { href: '/about', label: 'About' },
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class="site-header">
  <nav class="wide-container nav-inner">
    <a href="/" class="site-logo">qing<span class="logo-dot">.</span>uno</a>
    <div class="nav-links">
      {navItems.map(item => (
        <a
          href={item.href}
          class:list={['nav-link', { active: isActive(item.href) }]}
        >
          {item.label}
        </a>
      ))}
    </div>
    <div class="header-actions">
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme" title="Toggle theme">
        <span class="theme-icon sun">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
        </span>
        <span class="theme-icon moon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </span>
      </button>
      <button class="mobile-toggle" aria-label="Toggle menu" id="mobile-toggle">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>
  <div class="mobile-menu" id="mobile-menu">
    {navItems.map(item => (
      <a
        href={item.href}
        class:list={['mobile-link', { active: isActive(item.href) }]}
      >
        {item.label}
      </a>
    ))}
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    z-index: 100;
    padding: 1.25rem 0;
    background: color-mix(in srgb, var(--color-bg) 80%, transparent);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-normal) ease;
  }

  .site-header:hover {
    border-bottom-color: var(--color-border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
    margin-top: -1.25rem;
  }

  .site-logo {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.04em;
    font-family: var(--font-mono);
    transition: opacity var(--duration-fast) ease;
  }

  .site-logo:hover {
    opacity: 0.7;
    color: var(--color-text);
  }

  .logo-dot {
    color: var(--color-accent);
  }

  .nav-links {
    display: flex;
    gap: 0.25rem;
  }

  .nav-link {
    color: var(--color-text-secondary);
    font-size: 0.825rem;
    font-weight: 500;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
    transition: all var(--duration-fast) ease;
  }

  .nav-link:hover {
    color: var(--color-text);
    background: var(--color-bg-secondary);
  }

  .nav-link.active {
    color: var(--color-accent);
    background: var(--color-accent-soft);
    font-weight: 600;
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .mobile-toggle span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--color-text);
    border-radius: 1px;
    transition: all var(--duration-fast) ease;
  }

  .mobile-menu {
    display: none;
    padding: 0.5rem 1.5rem 1rem;
    background: color-mix(in srgb, var(--color-bg) 95%, transparent);
    backdrop-filter: blur(16px);
  }

  .mobile-menu.open { display: block; }

  .mobile-link {
    display: block;
    padding: 0.65rem 0.75rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    border-radius: var(--radius-sm);
    transition: all var(--duration-fast) ease;
  }

  .mobile-link:hover,
  .mobile-link.active {
    color: var(--color-text);
    background: var(--color-bg-secondary);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: var(--color-bg-card);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all var(--duration-fast) ease;
  }

  .theme-toggle:hover {
    color: var(--color-text);
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .theme-icon {
    display: none;
    align-items: center;
    justify-content: center;
  }

  /* Default: auto mode — show moon icon (suggests dark available) */
  .theme-toggle .theme-icon.moon { display: flex; }

  [data-theme="dark"] .theme-toggle .theme-icon.moon { display: none; }
  [data-theme="dark"] .theme-toggle .theme-icon.sun { display: flex; }

  [data-theme="light"] .theme-toggle .theme-icon.sun { display: none; }
  [data-theme="light"] .theme-toggle .theme-icon.moon { display: flex; }

  @media (max-width: 640px) {
    .nav-links { display: none; }
    .mobile-toggle { display: flex; }
    .site-header { padding: 0.75rem 0; }
    .nav-inner { margin-top: -0.75rem; }
  }
</style>

<script>
  // Mobile menu
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('open');
  });

  // Theme toggle
  const themeToggle = document.getElementById('theme-toggle');
  const html = document.documentElement;

  // Init: read preference from localStorage or system
  const stored = localStorage.getItem('theme');
  if (stored === 'dark' || stored === 'light') {
    html.setAttribute('data-theme', stored);
  }

  themeToggle?.addEventListener('click', () => {
    const current = html.getAttribute('data-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
  });
</script>
