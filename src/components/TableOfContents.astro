---
// Table of Contents — auto-generated from headings in the article body
// Uses IntersectionObserver for active heading highlighting
---

<nav class="toc" id="toc">
  <div class="toc-title">On this page</div>
  <ul class="toc-list" id="toc-list"></ul>
</nav>

<style>
  .toc {
    display: none;
    flex: 0 0 auto;
    width: 200px;
    position: sticky;
    top: calc(var(--nav-height) + 1.5rem);
    max-height: calc(100vh - var(--nav-height) - 3rem);
    overflow-y: auto;
    font-size: 0.78rem;
    padding: 1rem 0 1rem 1.25rem;
    border-left: 2px solid var(--color-border);
    /* Hide scrollbar by default, show on hover */
    scrollbar-width: thin;
    scrollbar-color: transparent transparent;
    transition: scrollbar-color 0.3s;
  }

  /* Show scrollbar thumb on hover */
  .toc:hover {
    scrollbar-color: var(--color-text-quaternary) transparent;
  }

  /* Webkit: hide scrollbar track, show thumb only on hover */
  .toc::-webkit-scrollbar {
    width: 4px;
  }

  .toc::-webkit-scrollbar-track {
    background: transparent;
  }

  .toc::-webkit-scrollbar-thumb {
    background: transparent;
    border-radius: 2px;
    transition: background 0.3s;
  }

  .toc:hover::-webkit-scrollbar-thumb {
    background: var(--color-text-quaternary);
  }

  .toc:hover::-webkit-scrollbar-thumb:hover {
    background: var(--color-text-tertiary);
  }

  @media (min-width: 1024px) {
    .toc {
      display: block;
      /* Self-adaptive: fills the gap between content (70ch) and viewport edge */
      width: calc((100vw - 70ch * 1.05 - 4rem - 2.5rem) / 2);
      min-width: 200px;
      max-width: 320px;
    }
  }

  @media (min-width: 1400px) {
    .toc {
      width: 300px;
    }
  }

  .toc-title {
    font-weight: 600;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
    margin-bottom: 0.5rem;
    white-space: nowrap;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-list li {
    margin-bottom: 0.2rem;
  }

  .toc-list a {
    display: block;
    color: var(--color-text-secondary);
    padding: 0.2rem 0;
    line-height: 1.55;
    transition: color 0.2s;
    word-break: break-word;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .toc-list a:hover,
  .toc-list a.active {
    color: var(--color-accent);
  }

  .toc-list .toc-h3 {
    padding-left: 0.75rem;
  }
</style>

<script>
  const postBody = document.querySelector('.post-body');
  const tocList = document.getElementById('toc-list');
  const tocNav = document.getElementById('toc');

  if (postBody && tocList && tocNav) {
    const headings = postBody.querySelectorAll('h2, h3');

    if (headings.length === 0) {
      tocNav.style.display = 'none';
    } else {
      headings.forEach((heading, index) => {
        if (!heading.id) {
          heading.id = `heading-${index}`;
        }

        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${heading.id}`;
        a.textContent = heading.textContent || '';
        if (heading.tagName === 'H3') {
          a.classList.add('toc-h3');
        }

        li.appendChild(a);
        tocList.appendChild(li);
      });

      // IntersectionObserver for active heading
      const links = tocList.querySelectorAll('a');
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              links.forEach((link) => link.classList.remove('active'));
              const activeLink = tocList.querySelector(`a[href="#${entry.target.id}"]`);
              if (activeLink) activeLink.classList.add('active');
            }
          });
        },
        { rootMargin: '-80px 0px -70% 0px' }
      );

      headings.forEach((heading) => observer.observe(heading));
    }
  }
</script>
