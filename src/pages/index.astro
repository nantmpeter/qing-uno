---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const recentPosts = posts.slice(0, 6);
const tags = [...new Set(posts.flatMap(p => p.data.tags))];
---

<BaseLayout title="qing.uno — AI, engineering & beyond">
  <section class="hero container">
    <div class="hero-text">
      <h1>qing.uno</h1>
      <p class="hero-tagline">AI, engineering & beyond.</p>
      <p class="hero-desc">
        Exploring the intersection of artificial intelligence, software engineering, and creative technology.
        Building things that matter.
      </p>
    </div>
  </section>

  <section class="container recent-section">
    <div class="section-header">
      <h2>Recent posts</h2>
      <a href="/blog" class="view-all">View all &rarr;</a>
    </div>
    <div class="posts-list">
      {recentPosts.map(post => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          slug={post.slug}
          heroImage={post.data.heroImage}
        />
      ))}
    </div>
    {recentPosts.length === 0 && (
      <div class="empty-state">
        <p>No posts yet. Stay tuned.</p>
      </div>
    )}
  </section>

  <section class="container tags-section">
    <h2>Topics</h2>
    <div class="tags-cloud">
      {tags.map(tag => (
        <a href={`/blog/tag/${tag}`} class="tag-pill">{tag}</a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 4rem 0 2rem;
  }

  .hero h1 {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    margin-bottom: 0.5rem;
  }

  .hero-tagline {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
  }

  .hero-desc {
    font-size: 0.95rem;
    color: var(--color-text-tertiary);
    max-width: 480px;
    line-height: 1.7;
  }

  .recent-section {
    padding-top: 1rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .section-header h2 {
    margin: 0;
    font-size: 1.25rem;
  }

  .view-all {
    font-size: 0.85rem;
    color: var(--color-text-tertiary);
  }

  .empty-state {
    text-align: center;
    padding: 3rem 0;
    color: var(--color-text-tertiary);
  }

  .tags-section {
    padding: 2rem 0;
  }

  .tags-section h2 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-pill {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    background: var(--color-bg-secondary);
    border-radius: 999px;
    transition: all 0.2s;
  }

  .tag-pill:hover {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  @media (max-width: 640px) {
    .hero { padding: 2.5rem 0 1.5rem; }
    .hero h1 { font-size: 1.8rem; }
  }
</style>
