---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const recentPosts = posts.slice(0, 6);
const tags = [...new Set(posts.flatMap(p => p.data.tags))];
---

<BaseLayout title="qing.uno — AI, engineering & beyond">
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-badge animate-in">
        <span class="badge-dot"></span>
        <span>Available for collaboration</span>
      </div>
      <h1 class="hero-title animate-in">
        I build things with
        <span class="gradient-text">AI & code.</span>
      </h1>
      <p class="hero-desc animate-in">
        Ship fast, break things, write about it. <br/>
        AI systems · Full-stack · Quant · Games
      </p>
      <div class="hero-links animate-in">
        <a href="/blog" class="hero-cta">
          Read the blog
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/about" class="hero-ghost">About me</a>
      </div>
    </div>
  </section>

  <section class="recent-section">
    <div class="section-header animate-in">
      <h2>Recent</h2>
      <a href="/blog" class="view-all">
        All posts
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
          <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
    <div class="posts-grid">
      {recentPosts.map((post, i) => (
        <div class="animate-in" style={`animation-delay: ${i * 80}ms`}>
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            slug={post.slug}
            heroImage={post.data.heroImage}
          />
        </div>
      ))}
    </div>
    {recentPosts.length === 0 && (
      <div class="empty-state animate-in">
        <p>No posts yet. Stay tuned.</p>
      </div>
    )}
  </section>

  <section class="tags-section animate-in">
    <h2>Topics</h2>
    <div class="tags-cloud">
      {tags.map(tag => (
        <a href={`/blog/tag/${tag}`} class="tag-pill">{tag}</a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero — full-width banner */
  .hero {
    width: 100%;
    padding: 0;
    background: linear-gradient(
      180deg,
      var(--color-bg-secondary) 0%,
      var(--color-bg) 100%
    );
    border-bottom: 1px solid var(--color-border);
  }

  .hero-inner {
    max-width: 960px;
    margin: 0 auto;
    padding: 5rem 2rem 4rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 420px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
    width: fit-content;
    letter-spacing: 0.01em;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .hero-title {
    font-size: var(--text-4xl);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: var(--tracking-tight);
    margin-bottom: 1.5rem;
    max-width: 720px;
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--color-accent) 0%, #a78bfa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  @media (prefers-color-scheme: dark) {
    .gradient-text {
      background: linear-gradient(135deg, #818cf8 0%, #c4b5fd 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .hero {
      background: linear-gradient(
        180deg,
        var(--color-bg-secondary) 0%,
        var(--color-bg) 100%
      );
    }
  }

  [data-theme="dark"] .gradient-text {
    background: linear-gradient(135deg, #818cf8 0%, #c4b5fd 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  [data-theme="dark"] .hero {
    background: linear-gradient(
      180deg,
      var(--color-bg-secondary) 0%,
      var(--color-bg) 100%
    );
  }

  .hero-desc {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
    max-width: 520px;
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  .hero-desc br {
    display: block;
    margin-bottom: 0.25rem;
    content: "";
  }

  .hero-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1.25rem;
    background: var(--color-accent);
    color: white;
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 500;
    transition: all var(--duration-normal) var(--ease-out);
  }

  .hero-cta:hover {
    color: white;
    background: var(--color-accent-hover);
    transform: translateX(2px);
    box-shadow: 0 8px 20px -4px rgba(13, 148, 136, 0.35);
  }

  .hero-ghost {
    padding: 0.6rem 1.25rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    transition: all var(--duration-normal) var(--ease-out);
  }

  .hero-ghost:hover {
    color: var(--color-text);
    border-color: var(--color-text-tertiary);
  }

  /* Recent */
  .recent-section {
    padding: 2rem 2rem 0;
    max-width: 960px;
    margin: 0 auto;
  }

  @media (max-width: 767px) {
    .recent-section {
      max-width: 70ch;
      padding: 1.5rem 1.5rem 0;
    }
  }

  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }

  @media (min-width: 768px) {
    .posts-grid {
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .section-header h2 {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-text-tertiary);
    margin: 0;
    font-weight: 600;
  }

  .view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    transition: all var(--duration-fast) ease;
  }

  .view-all:hover {
    color: var(--color-text);
    gap: 0.4rem;
  }

  .empty-state {
    text-align: center;
    padding: 3rem 0;
    color: var(--color-text-tertiary);
  }

  /* Tags */
  .tags-section {
    padding: 2.5rem 2rem 1rem;
    max-width: 960px;
    margin: 0 auto;
  }

  .tags-section h2 {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-text-tertiary);
    margin-bottom: 1rem;
    font-weight: 600;
    margin-top: 0;
  }

  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-pill {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-full);
    transition: all var(--duration-normal) var(--ease-out);
  }

  .tag-pill:hover {
    color: var(--color-accent);
    border-color: var(--color-accent-border);
    background: var(--color-accent-soft);
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .hero-inner { padding: 3rem 1.5rem 2.5rem; min-height: auto; }
    .hero-title { font-size: 2rem; }
    .hero-desc { font-size: var(--text-base); }
    .hero-links { flex-direction: column; align-items: flex-start; }
  }
</style>
