---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog | qing.uno" description="All posts — AI, engineering, and creative technology">
  <section class="blog-list-section">
    <div class="page-header animate-in">
      <h1>Blog</h1>
      <p class="page-desc">Thoughts on AI, engineering, and building things.</p>
    </div>
    <div class="posts-list">
      {posts.map((post, i) => (
        <div class="animate-in" style={`animation-delay: ${i * 60}ms`}>
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            slug={post.slug}
            heroImage={post.data.heroImage}
          />
        </div>
      ))}
    </div>
    {posts.length === 0 && (
      <div class="empty-state animate-in">
        <p>No posts yet. Check back soon.</p>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .blog-list-section {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  @media (max-width: 767px) {
    .blog-list-section {
      max-width: 70ch;
      padding: 0 1.5rem;
    }
  }

  .page-header {
    padding: 5rem 0 2rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 0.5rem;
  }

  .page-header h1 {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    margin-bottom: 0.5rem;
    margin-top: 0;
  }

  .page-desc {
    color: var(--color-text-secondary);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
  }

  .empty-state {
    text-align: center;
    padding: 4rem 0;
    color: var(--color-text-tertiary);
  }

  @media (max-width: 640px) {
    .page-header { padding: 4rem 0 1.5rem; }
  }
</style>
