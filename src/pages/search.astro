---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search | qing.uno" description="Search all posts">
  <section class="container search-page">
    <h1>Search</h1>
    <div id="search" class="search-container">
      <div id="searchbox" class="search-box"></div>
      <div id="search-results" class="search-results"></div>
    </div>
  </section>
</BaseLayout>

<style>
  .search-page {
    padding: 5rem 0 2rem;
  }

  .search-page h1 {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    margin-bottom: 1.5rem;
    margin-top: 0;
  }

  .search-box {
    margin-bottom: 1.5rem;
  }

  .search-results {
    min-height: 200px;
  }

  .search-results :global(.pagefind-ui__result-title) {
    font-weight: 600;
    font-size: var(--text-md);
    line-height: var(--leading-snug);
  }

  .search-results :global(.pagefind-ui__result-excerpt) {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .search-results :global(.pagefind-ui__search-clear) {
    cursor: pointer;
  }

  .search-results :global(.pagefind-ui__filter-name) {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-text-tertiary);
  }
</style>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  new PagefindUI({
    element: '#searchbox',
    showSubResults: true,
    showImages: false,
  });
</script>
