---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagList from '../components/TagList.astro';
import Comments from '../components/Comments.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import BackToTop from '../components/BackToTop.astro';
import CodeCopy from '../components/CodeCopy.astro';
import TableOfContents from '../components/TableOfContents.astro';
import SEOHead from '../components/SEOHead.astro';
import Tldr from '../components/Tldr.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  ogImage?: string;
  tags?: string[];
  category?: string;
  slug?: string;
  keywords?: string[];
  tldr?: string;
}

const { title, description, pubDate, updatedDate, heroImage, ogImage, tags = [], category, slug = '', keywords = [], tldr } = Astro.props;
const socialImage = ogImage || heroImage;
const currentPath = Astro.url.pathname;
---

<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <meta property="og:url" content={`https://qing.uno${currentPath}`} />
  {socialImage && <meta property="og:image" content={`https://qing.uno${socialImage}`} />}
  <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {socialImage && <meta name="twitter:image" content={`https://qing.uno${socialImage}`} />}
  <link rel="alternate" type="application/rss+xml" title="qing.uno RSS Feed" href="/rss.xml" />
  <SEOHead
    title={title}
    description={description}
    pubDate={pubDate}
    updatedDate={updatedDate}
    heroImage={heroImage}
    tags={tags}
    keywords={keywords}
    category={category}
  />
  <title>{title} | qing.uno</title>
</head>
<body>
  <ReadingProgress />
  <Header currentPath={currentPath} />

  <main class="post-layout">
    <div class="container">
      <article class="blog-post">
        <header class="post-header">
          {category && <span class="post-category">{category}</span>}
          <h1 class="post-title">{title}</h1>
          <div class="post-meta-row">
            <FormattedDate date={pubDate} />
            {updatedDate && (
              <span class="updated">
                &middot; updated <FormattedDate date={updatedDate} />
              </span>
            )}
          </div>
          <TagList tags={tags} />
        </header>

        {heroImage && (
          <div class="hero-image">
            <img src={heroImage} alt={title} />
          </div>
        )}

        <Tldr summary={tldr} />

        <div class="post-body">
          <slot />
        </div>

        <CodeCopy />
        <Comments slug={slug} />
      </article>
    </div>
    <TableOfContents />
  </main>

  <BackToTop />
  <Footer />
</body>
</html>

<style>
  .blog-post {
    padding-top: 6rem;
    padding-bottom: 3rem;
  }

  .post-header {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .post-category {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    font-family: var(--font-mono);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
  }

  .post-title {
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.04em;
    margin-bottom: 0.75rem;
  }

  .post-meta-row {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    margin-bottom: 0.75rem;
  }

  .updated {
    color: var(--color-text-quaternary);
  }

  .hero-image {
    margin-bottom: 2rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .hero-image img {
    width: 100%;
    display: block;
  }

  .post-body {
    font-size: 1rem;
    line-height: 1.8;
  }

  .post-body :global(h2) {
    font-size: 1.4rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    letter-spacing: -0.03em;
  }

  .post-body :global(h3) {
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .post-body :global(img) {
    border-radius: var(--radius-md);
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
  }

  .post-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-accent-border);
    transition: all var(--duration-fast) ease;
  }

  .post-body :global(a:hover) {
    color: var(--color-accent-hover);
    text-decoration-color: var(--color-accent-hover);
  }

  .post-body :global(blockquote) {
    border-left-color: var(--color-text-quaternary);
  }

  .post-body :global(code) {
    font-size: 0.82em;
  }

  .post-body :global(pre) {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .post-layout {
    display: grid;
    grid-template-columns: 1fr 200px;
    gap: 2rem;
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media (max-width: 1080px) {
    .post-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .blog-post { padding-top: 4.5rem; }
    .post-title { font-size: 1.65rem; }
  }
</style>
